{
  "manifest_version": 3,
  "name": "Retro Search Panel",
  "description": "Compact, retro-styled search panel for Chrome with background BM25 and IndexedDB.",
  "version": "1.0.0",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon-32.png"
  },
  "background": {
    "service_worker": "../extension_background/src/service_worker.js"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon-16.png",
        "icon-32.png",
        "icon-48.png",
        "icon-128.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
